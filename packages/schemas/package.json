{
  "name": "schemas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fa": {
      "types": "./dist/fa.d.ts",
      "default": "./dist/fa.js"
    },
    "./fa-text": {
      "types": "./dist/faText.d.ts",
      "default": "./dist/faText.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.0",
    "dayjs": "^1.11.13",
    "jalaliday": "^3.1.1"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
