# See masterPlan.md §11 for the full rationale behind each variable.
# Copy this file to apps/web/.env.local and apps/api/.env — never commit real values.

# ---- apps/web ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_LOCALE=fa
NEXT_PUBLIC_ENAMAD_ID=
REVALIDATE_SECRET=

# ---- apps/api ----
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000
MONGODB_URI=mongodb://localhost:27017/parsian-store
CORS_ORIGINS=http://localhost:3000

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Providers default to mock so Phases 2-8 run with zero external accounts.
SMS_PROVIDER=mock
KAVENEGAR_API_KEY=
OTP_TEMPLATE=

PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_KEY=
S3_SECRET=

SEARCH_DRIVER=mongo
MEILI_HOST=
MEILI_KEY=

ADMIN_SEED_PHONE=
LOG_LEVEL=info
