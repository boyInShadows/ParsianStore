# ParsianStore — production environment template.
#
# Copy to `.env.production` NEXT TO compose.prod.yaml and fill it in:
#
#   cp .env.production.example .env.production && chmod 600 .env.production
#
# `.env.production` is covered by .gitignore's `.env.*` rule. Never commit it,
# never paste its contents into an issue, a chat, or a screenshot.
#
# Every command in docs/deployment.md passes this file explicitly:
#
#   docker compose --env-file .env.production -f compose.prod.yaml <command>
#
# Compose refuses to start if any of the required values below is missing or
# empty — it names the variable and stops, rather than starting with a default.
# That is deliberate: no credential in this stack has a fallback value.
#
# This file mirrors .env.example, which is the DEVELOPMENT template and stays
# the reference for what each variable means. Only the deployment-relevant
# subset is here; anything absent keeps the default in
# apps/api/src/config/env.ts.

# ---------------------------------------------------------------- database --
# POSTGRES_* initialise the database container on FIRST START ONLY. Changing
# them later does not change the running cluster's credentials — see the
# "I changed POSTGRES_PASSWORD and the api cannot connect" entry in
# docs/deployment.md.
POSTGRES_DB=parsian_store
POSTGRES_USER=parsianstore
# Generate, do not invent:  openssl rand -base64 24
# Avoid  @ : / ? # [ ] %  — DATABASE_URL below is a URL and those characters
# have to be percent-encoded in it. A base64 password can contain / and +;
# regenerate rather than escape if you get one that does.
POSTGRES_PASSWORD=

# The host is `postgres` — the compose service name, reachable on the stack's
# internal network. NOT localhost, NOT 5433 (that is development's published
# port), and the database is never published to the host at all in production.
# The three values must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
# above exactly; nothing cross-checks them for you, a mismatch shows up as
# "password authentication failed" in the migrate service's log.
DATABASE_URL=postgresql://parsianstore:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/parsian_store?schema=public

# ------------------------------------------------------------------- auth --
# Both must be at least 32 characters (apps/api/src/config/env.ts enforces it
# and the API refuses to boot otherwise), and they must differ from each
# other: the refresh secret is the one that would let an attacker mint new
# sessions indefinitely.
#
# Generate one for each:
#
#   openssl rand -hex 32
#
# (or, with no openssl:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" )
#
# Rotating them logs every user out — that is the intended effect, and the
# correct response to any suspicion that one has leaked.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ------------------------------------------------------------- public URLs --
# Public origins, as a browser sees them. Use https:// in production: the
# storefront only sends its HSTS header when NEXT_PUBLIC_SITE_URL is an https
# origin (apps/web/next.config.mjs explains why that, and not NODE_ENV, is the
# gate).
#
# NEXT_PUBLIC_* ARE BUILD-TIME VALUES. They are compiled into the JavaScript
# the browser downloads, so changing one means `docker compose build web`,
# not a restart.
NEXT_PUBLIC_SITE_URL=https://example.ir
NEXT_PUBLIC_API_URL=https://api.example.ir
NEXT_PUBLIC_DEFAULT_LOCALE=fa
# Iranian e-commerce trust seal id. Empty until the seal is issued.
NEXT_PUBLIC_ENAMAD_ID=
# Shared secret for on-demand revalidation requests, if used. Generate like
# the JWT secrets above. Leave empty if nothing calls the revalidate route.
REVALIDATE_SECRET=

# The origin the API serves its own uploaded imagery from. Whatever value is
# here is prefixed onto every product image URL the API hands out, so a wrong
# one is visible as missing photos rather than as an error.
PUBLIC_URL=https://api.example.ir

# Browser origins allowed to call the API with credentials, comma-separated.
# ORDER MATTERS: checkout reads the first entry as the storefront's own origin
# when it builds the post-payment redirect, so the site URL goes first.
CORS_ORIGINS=https://example.ir

# -------------------------------------------------------------- providers --
# Both default to a mock implementation that needs no external account. Switch
# them over only when the real credentials exist.
#
# SMS_PROVIDER=mock sends no SMS at all: the one-time password is written to
# the API log instead. That is fine for a first deploy and NOT fine once real
# customers sign in — see docs/deployment.md.
SMS_PROVIDER=mock
KAVENEGAR_API_KEY=
OTP_TEMPLATE=

# PAYMENT_PROVIDER=mock marks orders paid without any money moving.
PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
# Leave "true" until the merchant id is live and tested end to end.
ZARINPAL_SANDBOX=true

STORAGE_DRIVER=local
SEARCH_DRIVER=postgres

# ------------------------------------------------------------- operations --
# The phone number `pnpm --filter api seed:staff` promotes to superadmin.
# Iranian mobile format, e.g. 09121234567. Required only for that one command.
ADMIN_SEED_PHONE=

LOG_LEVEL=info

# ----------------------------------------------------- host port bindings --
# Where the two published ports land on the VPS. The defaults bind to
# loopback, which is what you want with a reverse proxy (nginx/Caddy/Traefik)
# terminating TLS in front of them. Set *_BIND=0.0.0.0 only if nothing else
# is doing that job — that exposes the port to the internet.
WEB_BIND=127.0.0.1
WEB_PORT=3000
API_BIND=127.0.0.1
API_PORT=4000

# Tag applied to the images this stack builds. Bump it per release if you want
# the previous image kept around to roll back to.
IMAGE_TAG=latest

# ------------------------------------------------------------- NOT here ----
# NODE_ENV is set to "production" by compose.prod.yaml itself and must not be
# overridden. apps/api/src/config/prisma.ts derives a SECOND database named
# <name>_test when NODE_ENV=test; that is correct locally and must be
# impossible here. TEST_DATABASE_URL and RATE_LIMIT_DISABLED belong to the
# test harness for the same reason and appear nowhere in this file.
