# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# turborepo
.turbo/

# next.js
.next/
out/

# build output
dist/
build/

# testing
/coverage
playwright-report/
test-results/

# local-disk StorageProvider (P2.S8) — uploaded/rendered images, dev-only
apps/api/uploads/

# landing-page render sources (P9.S2) — 113MB of 2048² PNGs and 1440p MP4s that
# feed scripts/optimize-landing.mjs. Only the optimized outputs it emits into
# apps/web/public/landing/ are committed; these masters live on the owner's disk.
# Inventory and provenance: docs/landing-assets.md.
/landing-src/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (never commit real secrets)
.env
.env.local
.env.*.local

# vercel (unused — kept only so an accidental `vercel link` doesn't get committed)
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/*
!.vscode/extensions.json

# agent memory / AI-session notes -- kept locally for this and future Claude
# Code sessions, deliberately not pushed to GitHub. masterPlan.md, README.md,
# and docs/audit.md are real product docs and stay tracked; these aren't.
/CLAUDE.md
/AGENTS.md
/docs/decisions/
/screenshots/
